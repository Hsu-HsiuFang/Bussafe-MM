# ============================================
# BusSafe MM - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it contains secrets!
# ============================================

# Supabase project URL (from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable (anon) key (from Supabase Dashboard → Settings → API)
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Full database connection string (from Supabase Dashboard → Settings → Database)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# Base URL for this API server
APP_BASE_URL=http://localhost:8000

# Frontend URL for CORS (your deployed Vercel URL)
FRONTEND_URL=https://your-app.vercel.app